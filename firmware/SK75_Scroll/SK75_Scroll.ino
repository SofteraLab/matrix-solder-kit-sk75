/*
  Softera Lab · Matrix Solder Kit · SK-75
  Scrolling text on the on-board ATtiny + MAX7219.

  Pins: DIN=D0 (PB0), CS=D3 (PB3), CLK=D2 (PB2)
  For a daisy-chain set NUM_DEVICES (OUT→IN).
*/

#include "SoftteraMax7219.h"
#include <avr/pgmspace.h>

static const uint8_t PIN_DIN = 0;
static const uint8_t PIN_CS  = 3;
static const uint8_t PIN_CLK = 2;
static const uint8_t NUM_DEVICES = 1;

SoftteraMax7219 matrix(PIN_DIN, PIN_CS, PIN_CLK, NUM_DEVICES);

// Minimal 5×7 uppercase A–Z + space
const uint8_t FONT[][5] PROGMEM = {
  {0x00,0x00,0x00,0x00,0x00}, // sp
  {0x7E,0x11,0x11,0x11,0x7E}, // A
  {0x7F,0x49,0x49,0x49,0x36}, // B
  {0x3E,0x41,0x41,0x41,0x22}, // C
  {0x7F,0x41,0x41,0x22,0x1C}, // D
  {0x7F,0x49,0x49,0x49,0x41}, // E
  {0x7F,0x09,0x09,0x09,0x01}, // F
  {0x3E,0x41,0x49,0x49,0x7A}, // G
  {0x7F,0x08,0x08,0x08,0x7F}, // H
  {0x00,0x41,0x7F,0x41,0x00}, // I
  {0x20,0x40,0x41,0x3F,0x01}, // J
  {0x7F,0x08,0x14,0x22,0x41}, // K
  {0x7F,0x40,0x40,0x40,0x40}, // L
  {0x7F,0x02,0x0C,0x02,0x7F}, // M
  {0x7F,0x04,0x08,0x10,0x7F}, // N
  {0x3E,0x41,0x41,0x41,0x3E}, // O
  {0x7F,0x09,0x09,0x09,0x06}, // P
  {0x3E,0x41,0x51,0x21,0x5E}, // Q
  {0x7F,0x09,0x19,0x29,0x46}, // R
  {0x46,0x49,0x49,0x49,0x31}, // S
  {0x01,0x01,0x7F,0x01,0x01}, // T
  {0x3F,0x40,0x40,0x40,0x3F}, // U
  {0x1F,0x20,0x40,0x20,0x1F}, // V
  {0x3F,0x40,0x38,0x40,0x3F}, // W
  {0x63,0x14,0x08,0x14,0x63}, // X
  {0x07,0x08,0x70,0x08,0x07}, // Y
  {0x61,0x51,0x49,0x45,0x43}, // Z
};

const char MSG[] = "  SK75 SOFTERA  ";

int glyphOf(char c) {
  if (c == ' ') return 0;
  if (c >= 'A' && c <= 'Z') return 1 + (c - 'A');
  if (c >= 'a' && c <= 'z') return 1 + (c - 'a');
  if (c >= '0' && c <= '9') return 0;
  return 0;
}

void drawAt(int16_t offset) {
  matrix.clear();
  int16_t x = -offset;
  for (uint8_t i = 0; MSG[i]; i++) {
    int gi = glyphOf(MSG[i]);
    for (uint8_t col = 0; col < 5; col++) {
      uint8_t bits = pgm_read_byte(&FONT[gi][col]);
      if (x >= 0 && x < 8 * NUM_DEVICES) {
        for (uint8_t y = 0; y < 7; y++) {
          if (bits & (1 << y)) matrix.setPixel((int8_t)x, (int8_t)(y + 1), true);
        }
      }
      x++;
    }
    x++;
  }
  matrix.show();
}

void setup() {
  matrix.begin(5);
}

void loop() {
  uint16_t w = (uint16_t)strlen(MSG) * 6;
  for (uint16_t o = 0; o < w; o++) {
    drawAt((int16_t)o);
    delay(70);
  }
}
